# Copy this file to .tailscale.env and run:
#   chmod 600 .tailscale.env
#
# Blank lines and lines starting with # are ignored.
# Inline comments starting with " #" are supported outside quotes.
# Double-quoted values support \" and \\; single-quoted values are literal.
#
# Local node settings
# -------------------
# TAILSCALE_AUTH_KEY is required for `tailnetctl.py join`.
# Create an Auth key in the "Auth keys" section:
#   https://console.tailscale.com/admin/settings/keys
TAILSCALE_AUTH_KEY=tskey-auth-REPLACE_ME

# Optional: path to a local file that contains only the auth key.
# This must be a file path, not the key itself. tailnetctl reads it as the
# current user and copies it to a private 0600 temp file before running tailscale.
# Within this file, takes precedence over TAILSCALE_AUTH_KEY when set.
TAILSCALE_AUTH_KEY_FILE=

# Optional: hostname to register for this machine instead of the OS hostname.
TAILSCALE_HOSTNAME=

# Optional: comma-separated tags advertised by this machine, for example tag:dev,tag:linux.
TAILSCALE_ADVERTISE_TAGS=

# Optional: true or false. Leave empty to use the Tailscale default.
TAILSCALE_ACCEPT_DNS=

# Control plane
# -------------
# Optional: custom control server URL (for example a Headscale instance).
# Leave empty to use the official Tailscale control plane.
TAILSCALE_LOGIN_SERVER=

# Remote peer connection settings
# -------------------------------
# Optional: SSH username on the remote peer selected by `ssh` / `web`.
# This is the account used to log in to the remote machine, not an account
# for other machines connecting into this host.
# If unset or empty, TTY sessions prompt for it. Pressing Enter at the prompt
# leaves the user unspecified, so ssh uses its own default.
TAILSCALE_REMOTE_SSH_USER=

# Optional: remote port used by `web` when --port is omitted.
TAILSCALE_REMOTE_WEB_PORT=80
